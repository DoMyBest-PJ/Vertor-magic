<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Task 1: Drop Zone / File Input Initial View -->
<VBox fx:id="dropZoneContainer" alignment="CENTER" prefHeight="780.0" prefWidth="1160.0" spacing="20.0" styleClass="drop-zone-container" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="se233.vertor_magic.controller.DropZoneController">
   <children>
      <VBox fx:id="dropCard" alignment="CENTER" maxHeight="450.0" maxWidth="650.0" onDragDropped="#onDropZoneDropped" onDragExited="#onDropZoneExited" onDragOver="#onDropZoneOver" spacing="16.0" styleClass="drop-card" VBox.vgrow="NEVER">
         <children>
            <Label styleClass="drop-title" text="Vector Magic" />
            <Label styleClass="drop-subtitle" text="Convert Raster Images (JPG, PNG) into Scalable Vector Graphics (SVG)" />
            <Region prefHeight="10.0" />
            <Label styleClass="drop-instruction" text="Drag &amp; Drop Images or ZIP Archive Here" />
            <Label styleClass="badge-format" text="Supported: Single JPG/PNG, Multiple JPG/PNG, or ZIP Archive containing images" />
            <Region prefHeight="10.0" />
            <HBox alignment="CENTER" spacing="15.0">
               <children>
                  <Button fx:id="btnBrowseFiles" mnemonicParsing="false" onAction="#onBrowseFilesClicked" styleClass="btn-primary" text="Choose Image Files..." />
                  <Button fx:id="btnBrowseZip" mnemonicParsing="false" onAction="#onBrowseZipClicked" styleClass="btn-secondary" text="Choose ZIP Archive..." />
               </children>
            </HBox>
         </children>
         <padding>
            <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
         </padding>
      </VBox>
   </children>
</VBox>
