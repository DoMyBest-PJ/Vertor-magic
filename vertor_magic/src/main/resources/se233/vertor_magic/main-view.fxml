<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Group?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="rootPane" prefHeight="780.0" prefWidth="1160.0" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="se233.vertor_magic.controller.MainController">
   <children>
      <!-- Task 1: Drop Zone / File Input Initial View -->
      <VBox fx:id="dropZoneContainer" alignment="CENTER" spacing="20.0" styleClass="drop-zone-container">
         <children>
            <VBox fx:id="dropCard" alignment="CENTER" maxHeight="450.0" maxWidth="650.0" onDragDropped="#onDropZoneDropped" onDragExited="#onDropZoneExited" onDragOver="#onDropZoneOver" spacing="16.0" styleClass="drop-card" VBox.vgrow="NEVER">
               <children>
                  <Label styleClass="drop-title" text="Vector Magic" />
                  <Label styleClass="drop-subtitle" text="Convert Raster Images (JPG, PNG) into Scalable Vector Graphics (SVG)" />
                  <Region prefHeight="10.0" />
                  <Label styleClass="drop-instruction" text="Drag &amp; Drop Images or ZIP Archive Here" />
                  <Label styleClass="badge-format" text="Supported: Single JPG/PNG, Multiple JPG/PNG, or ZIP Archive containing images" />
                  <Region prefHeight="10.0" />
                  <HBox alignment="CENTER" spacing="15.0">
                     <children>
                        <Button fx:id="btnBrowseFiles" mnemonicParsing="false" onAction="#onBrowseFilesClicked" styleClass="btn-primary" text="Choose Image Files..." />
                        <Button fx:id="btnBrowseZip" mnemonicParsing="false" onAction="#onBrowseZipClicked" styleClass="btn-secondary" text="Choose ZIP Archive..." />
                     </children>
                  </HBox>
               </children>
               <padding>
                  <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
               </padding>
            </VBox>
         </children>
      </VBox>

      <!-- Task 2: Main Editor Interface -->
      <BorderPane fx:id="editorContainer" visible="false">
         <!-- Task 2.B: Top Panel (Strictly contains ONLY these three controls) -->
         <top>
            <HBox fx:id="topToolBar" alignment="CENTER_LEFT" spacing="12.0" styleClass="top-toolbar">
               <children>
                  <Button fx:id="btnZoomIn" mnemonicParsing="false" onAction="#onZoomInClicked" styleClass="tool-button" text="Zoom In" />
                  <Button fx:id="btnZoomOut" mnemonicParsing="false" onAction="#onZoomOutClicked" styleClass="tool-button" text="Zoom Out" />
                  <Button fx:id="btnZoomFit" mnemonicParsing="false" onAction="#onZoomFitClicked" styleClass="tool-button" text="Zoom to Fit" />
               </children>
            </HBox>
         </top>

         <!-- Task 2.A: Center Preview (Side-by-side original image and vectorized result) -->
         <center>
            <SplitPane fx:id="centerSplitPane" dividerPositions="0.5" styleClass="preview-pane">
               <items>
                  <!-- Original Image Preview -->
                  <VBox spacing="8.0" styleClass="preview-box">
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                           <children>
                              <Label styleClass="preview-header" text="Original Image" />
                              <Label fx:id="lblOriginalInfo" styleClass="preview-subtext" text="-- x -- px" />
                           </children>
                        </HBox>
                        <ScrollPane fx:id="originalScrollPane" fitToHeight="true" fitToWidth="true" styleClass="checkerboard-scroll" VBox.vgrow="ALWAYS">
                           <content>
                              <StackPane alignment="CENTER">
                                 <children>
                                    <ImageView fx:id="originalImageView" pickOnBounds="true" preserveRatio="true" />
                                 </children>
                              </StackPane>
                           </content>
                        </ScrollPane>
                     </children>
                     <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                     </padding>
                  </VBox>

                  <!-- Vectorized Result Preview -->
                  <VBox spacing="8.0" styleClass="preview-box">
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                           <children>
                              <Label styleClass="preview-header" text="Vectorized Result (SVG)" />
                              <Label fx:id="lblVectorInfo" styleClass="preview-subtext" text="Scalable Vector Graphics" />
                           </children>
                        </HBox>
                        <ScrollPane fx:id="vectorScrollPane" fitToHeight="true" fitToWidth="true" styleClass="checkerboard-scroll" VBox.vgrow="ALWAYS">
                           <content>
                              <StackPane fx:id="vectorContainer" alignment="CENTER">
                                 <children>
                                    <Group fx:id="vectorGroup" />
                                 </children>
                              </StackPane>
                           </content>
                        </ScrollPane>
                     </children>
                     <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                     </padding>
                  </VBox>
               </items>
            </SplitPane>
         </center>

         <!-- Task 2.C: Right Panel -->
         <right>
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="right-panel">
               <content>
                  <VBox spacing="14.0">
                     <children>
                        <!-- Task 3: Image Navigation -->
                        <Label styleClass="section-title" text="Image Navigation" />
                        <HBox alignment="CENTER" spacing="10.0">
                           <children>
                              <Button fx:id="btnBack" mnemonicParsing="false" onAction="#onBackClicked" styleClass="nav-button" text="◀ Back" />
                              <Label fx:id="lblImageCounter" styleClass="nav-counter" text="1 / 1" />
                              <Button fx:id="btnNext" mnemonicParsing="false" onAction="#onNextClicked" styleClass="nav-button" text="Next ▶" />
                           </children>
                        </HBox>
                        <Label fx:id="lblCurrentFileName" alignment="CENTER" maxWidth="1.7976931348623157E308" styleClass="preview-subtext" text="filename.png" textAlignment="CENTER" />
                        <Separator />

                        <!-- Task 4: Detail Level Configuration -->
                        <Label styleClass="section-title" text="Detail Level" />
                        <VBox spacing="8.0">
                           <children>
                              <RadioButton fx:id="rbLow" mnemonicParsing="false" onAction="#onDetailChanged" text="Low">
                                 <toggleGroup>
                                    <ToggleGroup fx:id="tgDetail" />
                                 </toggleGroup>
                              </RadioButton>
                              <RadioButton fx:id="rbMedium" mnemonicParsing="false" onAction="#onDetailChanged" selected="true" text="Medium" toggleGroup="$tgDetail" />
                              <RadioButton fx:id="rbHigh" mnemonicParsing="false" onAction="#onDetailChanged" text="High" toggleGroup="$tgDetail" />
                           </children>
                        </VBox>
                        <Separator />

                        <!-- Task 5: Color Configuration -->
                        <Label styleClass="section-title" text="Colors" />
                        <VBox spacing="8.0">
                           <children>
                              <RadioButton fx:id="rbUnlimited" mnemonicParsing="false" onAction="#onColorModeChanged" text="Unlimited (Full Palette)">
                                 <toggleGroup>
                                    <ToggleGroup fx:id="tgColor" />
                                 </toggleGroup>
                              </RadioButton>
                              <RadioButton fx:id="rbCustom" mnemonicParsing="false" onAction="#onColorModeChanged" selected="true" text="Custom (Limited)" toggleGroup="$tgColor" />
                           </children>
                        </VBox>
                        <VBox fx:id="customColorsBox" spacing="6.0">
                           <children>
                              <Label fx:id="lblDetectedColors" styleClass="preview-subtext" text="Detected Colors: --" />
                              <Label fx:id="lblColorLimitHint" styleClass="preview-subtext" text="Color limit (max 5, default 2):" />
                              <Spinner fx:id="spnColorCount" editable="false" prefWidth="120.0" />
                           </children>
                           <padding>
                              <Insets left="16.0" />
                           </padding>
                        </VBox>
                        <Separator />

                        <!-- Task 6: Background Removal -->
                        <Label styleClass="section-title" text="Background" />
                        <CheckBox fx:id="chkRemoveBackground" mnemonicParsing="false" onAction="#onRemoveBackgroundChanged" text="Remove Background" />
                        <Label styleClass="preview-subtext" text="(Produces transparent SVG output)" />
                        <Separator />

                        <!-- Task 12: Additional Features (Reset & History) -->
                        <Label styleClass="section-title" text="Extra Tools" />
                        <VBox spacing="8.0">
                           <children>
                              <Button fx:id="btnResetSettings" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onResetSettingsClicked" styleClass="btn-secondary" text="↺ Reset Settings" />
                              <Button fx:id="btnHistory" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onHistoryClicked" styleClass="btn-secondary" text="📁 Export History" />
                           </children>
                        </VBox>
                        <Separator />

                        <!-- Task 2.C & Task 8: Export All Button -->
                        <Label styleClass="section-title" text="Batch Export" />
                        <Button fx:id="btnExportAll" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onExportAllClicked" styleClass="btn-primary" text="⬇ Export All (SVG)" />
                        <Button fx:id="btnImportMore" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onImportMoreClicked" styleClass="btn-secondary" text="+ Import More Images" />
                     </children>
                     <padding>
                        <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
                     </padding>
                  </VBox>
               </content>
            </ScrollPane>
         </right>

         <!-- Bottom Status Bar (Progress, Tasks, Task 9 Conditional Parallel Indicator) -->
         <bottom>
            <HBox alignment="CENTER_LEFT" spacing="14.0" styleClass="status-bar">
               <children>
                  <Label fx:id="lblStatus" maxWidth="1.7976931348623157E308" styleClass="status-label" text="Ready" HBox.hgrow="ALWAYS" />
                  <Label fx:id="lblParallelStatus" styleClass="parallel-badge" text="Task 9: Parallel Eligible" />
                  <ProgressBar fx:id="progressBar" prefWidth="220.0" progress="0.0" />
               </children>
            </HBox>
         </bottom>
      </BorderPane>
   </children>
</StackPane>
